{
  "name": "@ckwalsh/signedsource-workspace",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "ci:attw": "pnpm run -r attw",
    "ci:build": "pnpm run -r build",
    "ci:publish": "pnpm publish -r",
    "ci:test": "node --no-warnings --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./jest.config.json",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache --fix .",
    "prepare": "husky",
    "typecheck": "tsc --noEmit --incremental"
  },
  "keywords": [],
  "author": "Cullen Walsh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ckwalsh/signedsource.git"
  },
  "packageManager": "pnpm@10.6.3",
  "engines": {
    "node": ">=22.14.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  },
  "type": "module",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.17.4",
    "@changesets/cli": "^2.28.1",
    "@ckwalsh/signedsource-eslint-plugin": "workspace:*",
    "@ckwalsh/signedsource": "workspace:*",
    "@eslint/js": "^9.24.0",
    "@tsconfig/node22": "^22.0.1",
    "@types/mustache": "^4.2.5",
    "@types/node": "^22.14.0",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-license-header": "^0.6.1",
    "eslint-plugin-prettier": "^5.2.6",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "jest": "catalog:",
    "mustache": "^4.2.0",
    "prettier": "^3.5.3",
    "ts-jest": "^29.3.1",
    "ts-node": "^10.9.2",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.29.0"
  }
}
