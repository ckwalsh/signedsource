{
  "name": "@ckwalsh/signedsource-workspace",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "attw": "pnpm run -r attw",
    "build": "pnpm run -r build",
    "clean": "rm -rf ./dist ./node_modules/.cache && pnpm run -r clean",
    "knip": "knip --treat-config-hints-as-errors",
    "lint": "eslint --cache",
    "lint:fix": "eslint --cache --fix",
    "lint-staged": "lint-staged",
    "test": "node --trace-warnings --experimental-vm-modules --disable-warning=ExperimentalWarning ./node_modules/jest/bin/jest.js",
    "tsc": "tsc --build",
    "tsc:watch": "tsc --build --watch",
    "prepare": "husky",
    "ci:publish": "pnpm publish --recursive"
  },
  "keywords": [],
  "author": "Cullen Walsh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ckwalsh/signedsource"
  },
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=18.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  },
  "type": "module",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@changesets/cli": "^2.29.7",
    "@ckwalsh/prettier-plugin-sort-imports": "^5.2.3",
    "@ckwalsh/typescript-dev-configs": "catalog:",
    "@tsconfig/node": "catalog:",
    "@types/node": "catalog:",
    "eslint": "^9.37.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "husky": "^9.1.7",
    "jest": "catalog:",
    "knip": "catalog:",
    "lint-staged": "^16.2.4",
    "prettier": "^3.6.2",
    "ts-jest": "catalog:",
    "typescript": "catalog:"
  }
}
