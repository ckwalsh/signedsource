{
  "name": "@ckwalsh/signedsource-workspace",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "knip": "knip",
    "lint": "eslint --cache",
    "lint-fix": "eslint --cache --fix",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "readme": "pnpm exec tsx .readme/update.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "Cullen Walsh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ckwalsh/signedsource"
  },
  "packageManager": "pnpm@10.8.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "warn"
    }
  },
  "type": "module",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.17.4",
    "@changesets/cli": "^2.29.2",
    "@ckwalsh/typescript-dev-configs": "github:ckwalsh/typescript-dev-configs#main",
    "@jest/globals": "^29.7.0",
    "@trivago/prettier-plugin-sort-imports": "github:ckwalsh/prettier-plugin-sort-imports",
    "eslint": "^9.26.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "knip": "^5.54.1",
    "lint-staged": "^15.5.2",
    "mustache": "^4.2.0",
    "prettier": "^3.5.3",
    "ts-jest": "^29.3.2",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "ts-jest": "^29.3.2"
  }
}
