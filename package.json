{
  "name": "@ckwalsh/signedsource-workspace",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "attw": "pnpm run -r attw",
    "build": "pnpm run -r build",
    "knip": "knip --treat-config-hints-as-errors --cache",
    "lint": "eslint",
    "lint:fix": "eslint --cache --fix",
    "lint-staged": "lint-staged",
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning ./node_modules/jest/bin/jest.js",
    "tsc": "pnpm run -r tsc",
    "prepare": "husky",
    "ci:publish": "pnpm publish -r"
  },
  "keywords": [],
  "author": "Cullen Walsh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ckwalsh/signedsource"
  },
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=18.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  },
  "type": "module",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@changesets/cli": "^2.29.4",
    "@ckwalsh/prettier-plugin-sort-imports": "^5.2.3",
    "@ckwalsh/typescript-dev-configs": "github:ckwalsh/typescript-dev-configs#main",
    "@tsconfig/node20": "^20.1.5",
    "@types/node": "^20.19.0",
    "eslint": "^9.29.0",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "knip": "^5.61.0",
    "lint-staged": "^16.1.0",
    "prettier": "^3.5.3",
    "ts-jest": "^29.4.0",
    "typescript": "^5.8.3"
  }
}
