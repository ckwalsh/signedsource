{
  "name": "@ckwalsh/signedsource",
  "version": "0.1.0",
  "description": "Library and cli to sign and verify generated code. Inspired by Meta's signedsource package.",
  "homepage": "https://github.com/ckwalsh/signedsource-ts#readme",
  "bugs": {
    "url": "https://github.com/ckwalsh/signedsource-ts/issues"
  },
  "license": "MIT",
  "author": "Cullen Walsh",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    "import": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "require": {
      "types": "./dist/lib/index.d.cts",
      "require": "./dist/lib/index.cjs"
    }
  },
  "module": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "main": "./dist/lib/index.cjs",
  "bin": {
    "signedsource": "dist/bin/signedsource.js"
  },
  "directories": {
    "lib": "dist/lib"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ckwalsh/signedsource.git"
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint",
    "lint-fix": "eslint --fix",
    "signedsource": "signedsource src/index.ts",
    "test": "vitest",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.17.3",
    "@eslint/js": "^9.19.0",
    "@types/node": "^22.13.0",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-license-header": "^0.6.1",
    "eslint-plugin-prettier": "^5.2.3",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "tsup": "^8.3.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.22.0",
    "vitest": "^3.0.4"
  }
}
