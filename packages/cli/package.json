{
  "name": "@ckwalsh/signedsource-cli",
  "version": "0.4.0",
  "description": "CLI to sign and verify generated code, based on Meta's signedsource package.",
  "homepage": "https://github.com/ckwalsh/signedsource/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/ckwalsh/signedsource/issues"
  },
  "license": "MIT",
  "author": "Cullen Walsh",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "signedsource": "dist/node/bin/signedsource.cjs"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/ckwalsh/signedsource",
    "directory": "packages/cli"
  },
  "scripts": {
    "attw": "pnpm-pack-and-attw --quiet || pnpm-pack-and-attw",
    "build": "tsup",
    "build:watch": "tsup --watch",
    "clean": "rm -rf ./dist ./node_modules/.cache",
    "knip": "pnpm run -w knip -W $(realpath --relative-to ../../ .)",
    "lint": "pnpm run -w lint $(realpath --relative-to ../../ .)",
    "lint:fix": "pnpm run -w lint:fix $(realpath --relative-to ../../ .)",
    "test": "pnpm run -w test --roots $(realpath --relative-to ../../ .) --",
    "tsc": "tsc --build",
    "tsc:watch": "tsc --build --watch",
    "prepare": "pnpm run clean && tsup --silent"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  },
  "dependencies": {
    "@ckwalsh/signedsource": "workspace:*",
    "clipanion": "4.0.0-rc.4"
  },
  "devDependencies": {
    "@ckwalsh/typescript-dev-configs": "catalog:",
    "@types/node": "catalog:",
    "jose": "^6.1.0",
    "knip": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:"
  }
}
