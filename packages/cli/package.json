{
  "name": "@ckwalsh/signedsource-cli",
  "version": "0.2.1",
  "description": "CLI to sign and verify generated code, based on Meta's signedsource package.",
  "homepage": "https://github.com/ckwalsh/signedsource/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/ckwalsh/signedsource/issues"
  },
  "license": "MIT",
  "author": "Cullen Walsh",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "signedsource": "dist/signedsource.cjs"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/ckwalsh/signedsource",
    "directory": "packages/cli"
  },
  "scripts": {
    "attw": "pnpm pack --out attw.tgz && attw --quiet attw.tgz || attw attw.tgz",
    "build": "tsup --silent",
    "build-watch": "tsup --watch",
    "knip": "knip",
    "lint": "eslint --cache",
    "lint-fix": "eslint --cache --fix",
    "lint-staged": "lint-staged",
    "prepare": "pnpm run build",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "typecheck": "tsc --noEmit"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  },
  "dependencies": {
    "@ckwalsh/signedsource": "workspace:*",
    "clipanion": "4.0.0-rc.4"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.17.4",
    "@ckwalsh/typescript-dev-configs": "github:ckwalsh/typescript-dev-configs#main",
    "@trivago/prettier-plugin-sort-imports": "github:ckwalsh/prettier-plugin-sort-imports",
    "@tsconfig/node24": "^24.0.1",
    "@types/node": "^24.0.1",
    "eslint": "^9.28.0",
    "jest": "^29.7.0",
    "jose": "^6.0.11",
    "knip": "^5.60.2",
    "lint-staged": "^15.5.2",
    "prettier": "^3.5.3",
    "ts-jest": "^29.3.4",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  }
}
