{
  "name": "@ckwalsh/signedsource-cli",
  "version": "0.1.1",
  "description": "CLI to sign and verify generated code, based on Meta's signedsource package.",
  "homepage": "https://github.com/ckwalsh/signedsource/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/ckwalsh/signedsource/issues"
  },
  "license": "MIT",
  "author": "Cullen Walsh",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "signedsource": "dist/bin/signedsource.cjs"
  },
  "type": "module",
  "exports": {
    "import": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "require": {
      "types": "./dist/src/index.d.cts",
      "require": "./dist/src/index.cjs"
    }
  },
  "module": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "main": "./dist/src/index.cjs",
  "directories": {
    "lib": "dist/src"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ckwalsh/signedsource",
    "directory": "packages/cli"
  },
  "scripts": {
    "attw": "pnpm pack --out attw.tgz && attw attw.tgz; rm -f attw.tgz",
    "build": "tsup --config ../tsup.config.ts src/index.ts bin/signedsource.ts",
    "prepack": "pnpm run build",
    "test": "node --no-warnings --experimental-vm-modules ../../node_modules/jest/bin/jest.js --config ../../jest.config.json ./packages/cli"
  },
  "devDependencies": {
    "@jest/globals": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  },
  "dependencies": {
    "@ckwalsh/signedsource": "workspace:*",
    "clipanion": "4.0.0-rc.4",
    "colors": "^1.4.0"
  }
}
