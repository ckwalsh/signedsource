{
  "name": "@ckwalsh/signedsource",
  "version": "0.2.0",
  "description": "Library to sign and verify generated code, based on Meta's signedsource package",
  "homepage": "https://github.com/ckwalsh/signedsource/packages/lib#readme",
  "bugs": {
    "url": "https://github.com/ckwalsh/signedsource/issues"
  },
  "license": "MIT",
  "author": "Cullen Walsh",
  "files": [
    "dist",
    "full",
    "partial",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "require": "./dist/index.cjs"
      }
    },
    "./full": {
      "import": {
        "types": "./dist/full/index.d.ts",
        "import": "./dist/full/index.js"
      },
      "require": {
        "types": "./dist/full/index.d.cts",
        "require": "./dist/full/index.cjs"
      }
    },
    "./partial": {
      "import": {
        "types": "./dist/partial/index.d.ts",
        "import": "./dist/partial/index.js"
      },
      "require": {
        "types": "./dist/partial/index.d.cts",
        "require": "./dist/partial/index.cjs"
      }
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.cjs",
  "directories": {
    "lib": "dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ckwalsh/signedsource",
    "directory": "packages/lib"
  },
  "scripts": {
    "attw": "pnpm pack --out attw.tgz && attw attw.tgz; rm -f attw.tgz",
    "build": "tsup --config ../tsup.config.ts src/index.ts src/full/index.ts src/partial/index.ts",
    "prepack": "pnpm run build",
    "readme": "echo '{}' | pnpx mustache -p ../examples/src/simple.ts -p ../examples/src/full.ts -p ../examples/src/partial.ts - README.md.mustache > README.md",
    "test": "node --no-warnings --experimental-vm-modules ../../node_modules/jest/bin/jest.js --config ../../jest.config.json ./packages/lib"
  },
  "devDependencies": {
    "@jest/globals": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  }
}
