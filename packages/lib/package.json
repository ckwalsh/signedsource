{
  "name": "@ckwalsh/signedsource",
  "version": "0.2.1",
  "description": "Library to sign and verify generated code, based on Meta's signedsource package.",
  "homepage": "https://github.com/ckwalsh/signedsource/packages/lib#readme",
  "bugs": {
    "url": "https://github.com/ckwalsh/signedsource/issues"
  },
  "license": "MIT",
  "author": "Cullen Walsh",
  "files": [
    "dist",
    "!dist/**/metafile*.json",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "imports": {
    "#*.ts": {
      "node": "./*.node.ts",
      "default": "./*.default.ts"
    }
  },
  "exports": {
    "source": "./src/index.ts",
    "node": {
      "import": {
        "types": "./dist/node/index.d.ts",
        "import": "./dist/node/index.js"
      },
      "require": {
        "types": "./dist/node/index.d.cts",
        "require": "./dist/node/index.cjs"
      }
    },
    "default": {
      "import": {
        "types": "./dist/neutral/index.d.ts",
        "import": "./dist/neutral/index.js"
      },
      "require": {
        "types": "./dist/neutral/index.d.cts",
        "require": "./dist/neutral/index.cjs"
      }
    }
  },
  "module": "./dist/neutral/index.js",
  "types": "./dist/neutral/index.d.ts",
  "main": "./dist/neutral/index.cjs",
  "directories": {
    "lib": "dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ckwalsh/signedsource",
    "directory": "packages/lib"
  },
  "scripts": {
    "attw": "pnpm-pack-and-attw --quiet || pnpm-pack-and-attw attw",
    "build": "tsup",
    "build:watch": "tsup --watch",
    "docs": "typedoc",
    "knip": "pnpm run -w knip -W $(realpath --relative-to ../../ .)",
    "lint": "pnpm run -w lint $(realpath --relative-to ../../ .)",
    "lint:fix": "pnpm run -w lint:fix $(realpath --relative-to ../../ .)",
    "test": "pnpm run -w test --roots $(realpath --relative-to ../../ .)",
    "tsc": "tsc --noEmit",
    "tsc:watch": "tsc --noEmit --watch",
    "prepare": "tsup --silent --clean"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  },
  "dependencies": {
    "crypto-js": "^4.2.0",
    "jose": "^6.0.11"
  },
  "devDependencies": {
    "@ckwalsh/typescript-dev-configs": "github:ckwalsh/typescript-dev-configs#main",
    "@jest/globals": "^30.0.0",
    "@tsconfig/node24": "^24.0.1",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^24.0.1",
    "knip": "^5.61.0",
    "tsup": "^8.5.0",
    "typedoc": "^0.28.5",
    "typescript": "^5.8.3"
  }
}
