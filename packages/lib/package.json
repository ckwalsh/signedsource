{
  "name": "@ckwalsh/signedsource",
  "version": "0.4.0",
  "description": "Library to sign and verify generated code, based on Meta's signedsource package.",
  "homepage": "https://github.com/ckwalsh/signedsource/packages/lib#readme",
  "bugs": {
    "url": "https://github.com/ckwalsh/signedsource/issues"
  },
  "license": "MIT",
  "author": "Cullen Walsh",
  "files": [
    "dist",
    "!dist/**/metafile*.json",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    "source": "./src/index.ts",
    "node": {
      "import": {
        "types": "./dist/node/src/index.d.ts",
        "import": "./dist/node/src/index.js"
      },
      "require": {
        "types": "./dist/node/src/index.d.cts",
        "require": "./dist/node/src/index.cjs"
      }
    },
    "default": {
      "import": {
        "types": "./dist/neutral/src/index.d.ts",
        "import": "./dist/neutral/src/index.js"
      },
      "require": {
        "types": "./dist/neutral/src/index.d.cts",
        "require": "./dist/neutral/src/index.cjs"
      }
    }
  },
  "module": "./dist/neutral/src/index.js",
  "types": "./dist/neutral/src/index.d.ts",
  "main": "./dist/neutral/src/index.cjs",
  "directories": {
    "lib": "dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ckwalsh/signedsource",
    "directory": "packages/lib"
  },
  "scripts": {
    "attw": "pnpm-pack-and-attw --quiet || pnpm-pack-and-attw",
    "build": "tsup",
    "build:watch": "tsup --watch",
    "clean": "rm -rf ./dist ./node_modules/.cache",
    "generate-docs": "typedoc --excludeInternal",
    "knip": "pnpm run -w knip -W $(realpath --relative-to ../../ .)",
    "lint": "pnpm run -w lint $(realpath --relative-to ../../ .)",
    "lint:fix": "pnpm run -w lint:fix $(realpath --relative-to ../../ .)",
    "test": "pnpm run -w test --roots $(realpath --relative-to ../../ .) --",
    "tsc": "tsc --build",
    "tsc:watch": "tsc --build --watch",
    "prepare": "pnpm --silent run clean && tsup --silent"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  },
  "dependencies": {
    "crypto-js": "^4.2.0",
    "jose": "^6.0.11"
  },
  "devDependencies": {
    "@ckwalsh/typescript-dev-configs": "catalog:",
    "@jest/globals": "catalog:",
    "@tsconfig/node": "catalog:",
    "@tsconfig/recommended": "catalog:",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "catalog:",
    "knip": "catalog:",
    "tsup": "catalog:",
    "typedoc": "^0.28.5",
    "typescript": "catalog:"
  }
}
