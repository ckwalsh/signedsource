{
  "name": "@ckwalsh/signedsource",
  "version": "0.2.1",
  "description": "Library to sign and verify generated code, based on Meta's signedsource package.",
  "homepage": "https://github.com/ckwalsh/signedsource/packages/lib#readme",
  "bugs": {
    "url": "https://github.com/ckwalsh/signedsource/issues"
  },
  "license": "MIT",
  "author": "Cullen Walsh",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "imports": {
    "#*.ts": {
      "node": "./*.node.ts",
      "default": "./*.default.ts"
    }
  },
  "exports": {
    "source": "./src/index.ts",
    "node": {
      "import": {
        "types": "./dist/node/index.d.ts",
        "import": "./dist/node/index.js"
      },
      "require": {
        "types": "./dist/node/index.d.cts",
        "require": "./dist/node/index.cjs"
      }
    },
    "default": {
      "import": {
        "types": "./dist/default/index.d.ts",
        "import": "./dist/default/index.js"
      },
      "require": {
        "types": "./dist/default/index.d.cts",
        "require": "./dist/default/index.cjs"
      }
    }
  },
  "module": "./dist/default/index.js",
  "types": "./dist/default/index.d.ts",
  "main": "./dist/default/index.cjs",
  "directories": {
    "lib": "dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ckwalsh/signedsource",
    "directory": "packages/lib"
  },
  "scripts": {
    "attw": "pnpm pack --out attw.tgz && attw --quiet attw.tgz || attw attw.tgz",
    "build": "tsup --silent",
    "build-watch": "tsup --watch",
    "doc": "typedoc",
    "knip": "knip",
    "lint": "eslint --cache",
    "lint-fix": "eslint --cache --fix",
    "lint-staged": "lint-staged",
    "prepare": "pnpm run build",
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning ./node_modules/jest/bin/jest.js",
    "typecheck": "tsc --noEmit"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  },
  "dependencies": {
    "jose": "^6.0.11"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.17.4",
    "@ckwalsh/typescript-dev-configs": "github:ckwalsh/typescript-dev-configs#main",
    "@jest/globals": "^29.7.0",
    "@trivago/prettier-plugin-sort-imports": "github:ckwalsh/prettier-plugin-sort-imports",
    "@tsconfig/node24": "^24.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^9.28.0",
    "jest": "^29.7.0",
    "knip": "^5.60.2",
    "lint-staged": "^15.5.2",
    "prettier": "^3.5.3",
    "ts-jest": "^29.3.4",
    "tsup": "^8.5.0",
    "typedoc": "^0.28.5",
    "typescript": "^5.8.3"
  }
}
