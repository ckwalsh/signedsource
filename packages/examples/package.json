{
  "name": "@ckwalsh/signedsource-examples",
  "version": "0.0.1",
  "private": true,
  "description": "Example usages of @ckwalsh/signedsource.",
  "homepage": "https://github.com/ckwalsh/signedsource/packages/examples#readme",
  "bugs": {
    "url": "https://github.com/ckwalsh/signedsource/issues"
  },
  "license": "MIT",
  "author": "Cullen Walsh",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    "import": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "require": "./dist/index.cjs"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.cjs",
  "directories": {
    "lib": "dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ckwalsh/signedsource",
    "directory": "packages/examples"
  },
  "scripts": {
    "attw": "pnpm pack --out attw.tgz && attw attw.tgz; rm -f attw.tgz",
    "build": "tsup --config ../tsup.config.ts src/index.ts",
    "prepack": "pnpm run build",
    "test": "node --no-warnings --experimental-vm-modules ../../node_modules/jest/bin/jest.js --config ../../jest.config.json ./packages/examples"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  },
  "dependencies": {
    "@ckwalsh/signedsource": "workspace:*"
  }
}
